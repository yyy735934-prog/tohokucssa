{
  "name": "tohoku-rental",
  "version": "1.0.0",
  "private": true,
  "description": "東北地区中国学友会 · 物资租赁平台",
  "scripts": {
    "dev": "vite --port 5181",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler pages deploy dist --project-name=tohoku-rental",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 execute tohoku-rental-db --remote --file=drizzle/latest.sql"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.2.0"
  }
}
