{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tohoku-market",
  "account_id": "2bc255aa48bd3bd1e9b4d6ae1dbbea2f",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "no_bundle": true,
  "base_dir": "./dist/server",
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "market.tohokucssa.org",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 9 * * *", "*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tohoku-market-db",
      "database_id": "9b6c4a99-2b83-4efd-81ed-955838116fb3",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tohoku-market-uploads"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "ding.junzhong.p4@dc.tohoku.ac.jp,hpwang1933@gmail.com",
    "EMAIL_FROM": "noreply@market-mail.tohokucssa.org",
    "COMETCHAT_WEBHOOK_USERNAME": "tohoku_market",
    "VAPID_PUBLIC_KEY": "BJX8cwmpTFoZx6Uu8zkSMCUimfU-HWBW9P5rq-HkWlGf_Y9Q22SHybrEXpLl8-Q9qbQxJLTXDcYOxbskFHLXeaU"
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "SESSION_SECRET",
      "RESEND_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "VAPID_PRIVATE_KEY",
      "COMETCHAT_APP_ID",
      "COMETCHAT_REGION",
      "COMETCHAT_REST_API_KEY",
      "COMETCHAT_WEBHOOK_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
